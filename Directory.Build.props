<Project>
  <!-- Repo-wide build settings: every csproj inherits these. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Vulnerable-dependency audit on restore, transitives included.
         NU19xx warnings become errors via TreatWarningsAsErrors — pinned
         here explicitly so the gate is chosen, not ambient SDK behavior. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- The linter: built-in Roslyn analyzers on the ecosystem-standard
         rule set (no StyleCop — the IDExxxx style rules + CA quality rules
         ARE the modern linter). latest-recommended enables the curated CA
         set as warnings; EnforceCodeStyleInBuild turns .editorconfig style
         rules into build diagnostics. TreatWarningsAsErrors makes both
         hard gates. Per-rule severities live in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Version is injected at publish time (-p:Version=X.Y.Z, from the
         git tag, by .github/workflows/release.yml); dev builds
         use the SDK default. Do not pin a version here — it is never what
         ships and only misleads. -->
    <Authors>VortexUK</Authors>
    <Product>EQ2Parser</Product>
    <RepositoryUrl>https://github.com/VortexUK/EQ2Parser</RepositoryUrl>
  </PropertyGroup>
</Project>
