<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EQ2Parser.Mac.ViewModels"
             xmlns:svc="using:EQ2Parser.App.Services"
             x:Class="EQ2Parser.Mac.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="18" Margin="4,10,16,16" MaxWidth="900" HorizontalAlignment="Left">

      <!-- Logs -->
      <StackPanel Spacing="6">
        <TextBlock Text="Log folders" Classes="header" FontSize="15" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Every eq2log_*.txt in these folders is read as soon as EQ2 writes to it. In EQ2, type /log to turn logging on." />
        <ListBox ItemsSource="{Binding WatchedFolders}" SelectedItem="{Binding SelectedFolder}"
                 MinHeight="60" MaxHeight="140" Background="#1A1D27" FontSize="12" />
        <WrapPanel>
          <Button Content="Find in CrossOver / Wine" Command="{Binding DetectFoldersCommand}" Margin="0,0,6,0" />
          <Button Content="Add folder…" Command="{Binding AddFolderCommand}" Margin="0,0,6,0" />
          <Button Content="Remove" Command="{Binding RemoveFolderCommand}" />
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Logs being read" Classes="header" FontSize="15" />
        <DataGrid ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                  MinHeight="60" MaxHeight="180" Background="#1A1D27">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Character" Binding="{Binding Owner}" Width="140" />
            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel>
          <Button Content="Add log…" Command="{Binding AddLogCommand}" Margin="0,0,6,0" />
          <CheckBox Content="Parse the whole file (older fights too)" IsChecked="{Binding ParseFromStart}" Margin="0,0,12,0" />
          <Button Content="Stop reading" Command="{Binding RemoveLogCommand}" />
        </WrapPanel>
      </StackPanel>

      <!-- Voice -->
      <StackPanel Spacing="6">
        <TextBlock Text="Alert voice" Classes="header" FontSize="15" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="macOS voices. Better ones (Enhanced / Premium) can be downloaded under System Settings → Accessibility → Spoken Content → System voice → Manage Voices." />
        <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" MinWidth="360"
                  PlaceholderText="System default voice">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="svc:TtsVoice">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Grid ColumnDefinitions="110,260,50" RowDefinitions="Auto,Auto">
          <TextBlock Text="Speaking rate" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="0.5" Maximum="2" Value="{Binding TtsRate}" />
          <TextBlock Grid.Column="2" Text="{Binding TtsRate, StringFormat={}{0:0.0}×}" VerticalAlignment="Center" Margin="8,0" />
          <TextBlock Grid.Row="1" Text="Alert volume" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AlertVolume}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AlertVolume, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="8,0" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding TestPhrase}" />
          <Button Grid.Column="1" Content="Test voice" Command="{Binding TestVoiceCommand}" Margin="6,0,0,0" />
        </Grid>
      </StackPanel>

      <!-- EQ2Lexicon -->
      <StackPanel Spacing="6">
        <TextBlock Text="EQ2Lexicon" Classes="header" FontSize="15" />
        <Border Background="#7F1D1D" CornerRadius="4" Padding="8,4" IsVisible="{Binding LoopbackOnly}">
          <TextBlock Foreground="White" FontSize="12" TextWrapping="Wrap"
                     Text="Test run (EQ2PARSER_LOOPBACK_ONLY): every request to anything but this machine is refused — nothing reaches the real site." />
        </Border>
        <TextBlock Text="{Binding LexiconUrl, StringFormat=Site: {0}}" Classes="muted" FontSize="12" />
        <CheckBox Content="Use the EQ2Lexicon trigger pack" IsChecked="{Binding LexiconTriggersEnabled}" />
        <TextBlock Text="Parse uploads" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Paste your API token from your EQ2Lexicon profile. It is kept in your macOS Keychain, never in the settings file. Only logs under logs/&lt;server&gt;/ are uploaded." />
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBox x:Name="TokenBox" PasswordChar="•" Watermark="API token" />
          <Button Grid.Column="1" Content="Save token" Command="{Binding SaveUploadTokenCommand}"
                  CommandParameter="{Binding #TokenBox}" Margin="6,0,0,0" />
          <Button Grid.Column="2" Content="Test" Command="{Binding TestUploadTokenCommand}" Margin="6,0,0,0" />
          <Button Grid.Column="3" Content="Remove" Command="{Binding ClearUploadTokenCommand}" Margin="6,0,0,0" />
        </Grid>
        <TextBlock Text="{Binding UploadTokenState}" Classes="muted" FontSize="12" />
        <CheckBox Content="Upload every finished fight automatically" IsChecked="{Binding UploadEnabled}" />
        <CheckBox Content="…but only raid fights (raid bosses, or 7+ players)" IsChecked="{Binding UploadRaidOnly}"
                  IsEnabled="{Binding UploadEnabled}" Margin="24,0,0,0" />
        <TextBlock Text="{Binding UploadStatus}" Foreground="#FBBF24" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Status}" Foreground="#FBBF24" FontSize="12" TextWrapping="Wrap" />
        <TextBlock Text="{Binding DataFolder, StringFormat=App data: {0}}" Classes="muted" FontSize="11" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
