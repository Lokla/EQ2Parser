<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EQ2Parser.Mac.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="EQ2Parser.Mac.Views.FightsView"
             x:DataType="vm:FightsViewModel">
  <Grid ColumnDefinitions="270,6,*" Margin="0,8,0,8">

    <!-- Fight list -->
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <TextBlock Text="Fights" Classes="header" VerticalAlignment="Center" />
        <ToggleButton Grid.Column="1" Content="Follow live" IsChecked="{Binding FollowLive}"
                      Command="{Binding FollowCommand}" Padding="10,3" FontSize="12" />
      </Grid>
      <ListBox ItemsSource="{Binding Fights}" SelectedItem="{Binding SelectedFight}" Background="#1A1D27">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:FightItem">
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

    <!-- The fight shown -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
        <Border Background="#4ADE80" CornerRadius="3" Padding="6,1" IsVisible="{Binding IsLive}" VerticalAlignment="Center"
                Margin="0,0,8,0">
          <TextBlock Text="LIVE" Foreground="#15171F" FontSize="11" FontWeight="Bold" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Breadcrumb}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Content="Upload to EQ2Lexicon" Command="{Binding UploadShownCommand}"
                Padding="10,3" FontSize="12" Margin="8,0,0,0" />
      </Grid>

      <!-- The combatant tables; double-click a row for its abilities. -->
      <Grid Grid.Row="1" RowDefinitions="2*,Auto,*" IsVisible="{Binding !DrillOpen}">
        <DataGrid x:Name="AlliesGrid" ItemsSource="{Binding Allies}" Background="#1A1D27" DoubleTapped="OnCombatantDoubleTapped">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Name" Width="2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:CombatantRowVm">
                  <Grid Margin="6,0">
                    <ProgressBar Value="{Binding Bar}" Maximum="1" MinHeight="22" Opacity="0.22"
                                 Foreground="{Binding ClassBrush}" Background="Transparent" CornerRadius="2" />
                    <TextBlock Text="{Binding Name}" Foreground="{Binding ClassBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="110" />
            <DataGridTextColumn Header="Time" Binding="{Binding Duration}" Width="76" />
            <DataGridTextColumn Header="Damage" Binding="{Binding Damage}" Width="94" />
            <DataGridTextColumn Header="%" Binding="{Binding Percent}" Width="56" />
            <DataGridTextColumn Header="EncDPS" Binding="{Binding Dps}" Width="92" />
            <DataGridTextColumn Header="EncHPS" Binding="{Binding Hps}" Width="94" />
            <DataGridTextColumn Header="Taken" Binding="{Binding Taken}" Width="86" />
            <DataGridTextColumn Header="Deaths" Binding="{Binding Deaths}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" Text="Enemies" Classes="header" Margin="0,10,0,4" />
        <DataGrid Grid.Row="2" x:Name="EnemiesGrid" ItemsSource="{Binding Enemies}" Background="#1A1D27" DoubleTapped="OnCombatantDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
            <DataGridTextColumn Header="Time" Binding="{Binding Duration}" Width="76" />
            <DataGridTextColumn Header="Damage" Binding="{Binding Damage}" Width="94" />
            <DataGridTextColumn Header="EncDPS" Binding="{Binding Dps}" Width="92" />
            <DataGridTextColumn Header="Taken" Binding="{Binding Taken}" Width="86" />
            <DataGridTextColumn Header="Deaths" Binding="{Binding Deaths}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- The drill-down: buckets, abilities, swings. -->
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding DrillOpen}">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
          <Button Content="‹ Back" Command="{Binding DrillBackCommand}" Padding="10,3" FontSize="12" />
          <TextBlock Grid.Column="1" Text="{Binding DrillTitle}" Classes="header" FontSize="14" VerticalAlignment="Center"
                     Margin="10,0" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Content="Close" Command="{Binding DrillCloseCommand}" Padding="10,3" FontSize="12" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding DrillHint}" Classes="muted" FontSize="11" Margin="0,0,0,4" />
        <Border Grid.Row="2" Background="#1A1D27" CornerRadius="4" Height="200" Margin="0,0,0,6" Padding="4"
                IsVisible="{Binding DrillShowsLines}">
          <lvc:CartesianChart Series="{Binding DrillLineSeries}" XAxes="{Binding DrillXAxes}" YAxes="{Binding DrillYAxes}"
                              LegendPosition="Right" LegendTextPaint="{Binding ChartTextPaint}"
                              TooltipTextPaint="{Binding ChartTextPaint}" TooltipBackgroundPaint="{Binding ChartTooltipBackground}"
                              AnimationsSpeed="0:0:0" />
        </Border>
        <Border Grid.Row="2" Background="#1A1D27" CornerRadius="4" Height="220" Margin="0,0,0,6" Padding="4"
                IsVisible="{Binding DrillShowsPie}">
          <lvc:PieChart Series="{Binding DrillPieSeries}" LegendPosition="Right" LegendTextPaint="{Binding ChartTextPaint}"
                        TooltipTextPaint="{Binding ChartTextPaint}" TooltipBackgroundPaint="{Binding ChartTooltipBackground}"
                        AnimationsSpeed="0:0:0" />
        </Border>
        <DataGrid Grid.Row="3" x:Name="AbilityGrid" ItemsSource="{Binding AbilityRows}" Background="#1A1D27"
                  IsVisible="{Binding !DrillShowsSwings}" DoubleTapped="OnAbilityDoubleTapped">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Name" Width="2.6*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:AbilityRowVm">
                  <Grid Margin="6,0">
                    <ProgressBar Value="{Binding Bar}" Maximum="1" MinHeight="22" Opacity="0.22"
                                 Foreground="#93B4FF" Background="Transparent" CornerRadius="2" />
                    <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" VerticalAlignment="Center" Margin="6,0"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="90" />
            <DataGridTextColumn Header="Crit" Binding="{Binding CritPct}" Width="64" />
            <DataGridTextColumn Header="Avg" Binding="{Binding Average}" Width="80" />
            <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="80" />
            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="90" />
            <DataGridTextColumn Header="DPS" Binding="{Binding Dps}" Width="84" />
            <DataGridTextColumn Header="Share" Binding="{Binding Share}" Width="70" />
            <DataGridTextColumn Header="Every" Binding="{Binding Every}" Width="74" />
            <DataGridTextColumn Header="Types" Binding="{Binding Types}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Row="3" ItemsSource="{Binding SwingRows}" Background="#1A1D27" IsVisible="{Binding DrillShowsSwings}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="84" />
            <DataGridTextColumn Header="Attacker" Binding="{Binding Attacker}" Width="*" />
            <DataGridTextColumn Header="Victim" Binding="{Binding Victim}" Width="*" />
            <DataGridTextColumn Header="Ability" Binding="{Binding Ability}" Width="*" />
            <DataGridTextColumn Header="Damage" Binding="{Binding Damage}" Width="90" />
            <DataGridTextColumn Header="Crit" Binding="{Binding Crit}" Width="56" />
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
            <DataGridTextColumn Header="Special" Binding="{Binding Special}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
