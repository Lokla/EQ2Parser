<Project Sdk="Microsoft.NET.Sdk">

  <!-- The macOS shell: Avalonia views over EQ2Parser.Shell, which carries
       the WPF app's own services. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EQ2Parser</AssemblyName>
    <RootNamespace>EQ2Parser.Mac</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\EQ2Parser.App\Assets\EQ2Parser.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQ2Parser.Shell\EQ2Parser.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <!-- The off-screen renderer behind the snapshot mode (Program.cs). -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
