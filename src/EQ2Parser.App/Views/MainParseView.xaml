<UserControl x:Class="EQ2Parser.App.Views.MainParseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EQ2Parser.App.Views"
             xmlns:vm="clr-namespace:EQ2Parser.App.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:loc="clr-namespace:EQ2Parser.App.Localization">
    <UserControl.Resources>
        <views:BarWidthConverter x:Key="BarWidth" />
        <views:ColumnWidthConverter x:Key="ColWidth" />
        <!-- Carries the VM into ColumnDefinitions (no visual-tree DataContext
             inside the row template) so header + rows collapse columns together. -->
        <views:BindingProxy x:Key="ColsProxy" Data="{Binding Columns}" />
        <views:BindingProxy x:Key="DrillColsProxy" Data="{Binding DrillColumns}" />
        <views:BindingProxy x:Key="SwingColsProxy" Data="{Binding SwingColumns}" />

        <!-- Column widths shared by header + rows. Name stretches. -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="GridRowTemplate" DataType="{x:Type vm:CombatantRow}">
            <Grid Margin="0,1" Cursor="Hand" Background="Transparent"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Tr Main_DrillDown}"
                                  Command="{Binding PlacementTarget.Tag.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{loc:Tr Main_ExportToClipboard}"
                                  Command="{Binding PlacementTarget.Tag.CopyCombatantCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{loc:Tr Main_ExportAbilityBreakdown}"
                                  Command="{Binding PlacementTarget.Tag.CopyBreakdownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{loc:Tr Main_DeathReport}"
                                  Command="{Binding PlacementTarget.Tag.DeathReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{loc:Tr Main_AvoidanceReport}"
                                  Command="{Binding PlacementTarget.Tag.AvoidanceReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{loc:Tr Main_SourcesReport}"
                                  Command="{Binding PlacementTarget.Tag.SourcesReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{loc:Tr Main_LookupAcrossFights}"
                                  Command="{Binding PlacementTarget.Tag.LookupCombatantCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Grid.InputBindings>
                <Border x:Name="BarHost" CornerRadius="3" Background="#0D1C1F2E" MinHeight="24">
                    <Border HorizontalAlignment="Left" CornerRadius="3"
                            Background="{StaticResource MeterBarBrush}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource BarWidth}">
                                <Binding Path="BarFraction" />
                                <Binding ElementName="BarHost" Path="ActualWidth" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
                <Grid Margin="8,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Class].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=118}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Time].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=56}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Damage].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=82}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Percent].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=44}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Dps].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=82}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Hps].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=82}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Heals].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=82}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[CritHeals].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=76}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Cures].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=56}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[PowerDrain].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=78}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[PowerRep].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=70}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Swings].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=62}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Hits].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=52}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Crits].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=54}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Misses].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=50}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Avoids].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=56}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[ToHit].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=60}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[CritPct].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=56}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Taken].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=82}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[HealsTaken].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=80}" />
                        <ColumnDefinition Width="{Binding Data.ByKey[Deaths].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=50}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource BodySemiBoldFont}" FontSize="13.5"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding ClassName}" Foreground="{Binding ClassBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Data.ByKey[Class].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Time].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="3" Text="{Binding Damage}" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="13" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Damage].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="4" Text="{Binding Percent}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Percent].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="5" Text="{Binding Dps}" Foreground="{StaticResource GoldBrightBrush}"
                               FontFamily="{StaticResource BodySemiBoldFont}" FontSize="13.5" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Dps].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="6" Text="{Binding Hps}" Foreground="{StaticResource SuccessBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="13" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Hps].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="7" Text="{Binding Heals}" Foreground="{StaticResource SuccessBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12.5" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Heals].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="8" Text="{Binding CritHeals}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[CritHeals].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="9" Text="{Binding Cures}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Cures].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="10" Text="{Binding PowerDrain}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[PowerDrain].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="11" Text="{Binding PowerRep}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[PowerRep].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="12" Text="{Binding Swings}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Swings].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="13" Text="{Binding Hits}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Hits].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="14" Text="{Binding Crits}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Crits].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="15" Text="{Binding Misses}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Misses].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="16" Text="{Binding Avoids}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Avoids].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="17" Text="{Binding ToHit}" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[ToHit].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="18" Text="{Binding CritPct}" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[CritPct].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="19" Text="{Binding Taken}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12.5" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Taken].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="20" Text="{Binding HealsTaken}" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12.5" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[HealsTaken].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="21" Text="{Binding Deaths}" Foreground="{StaticResource DangerBrush}"
                               FontFamily="{StaticResource BodyFont}" FontSize="12.5" TextAlignment="Right"
                               Visibility="{Binding Data.ByKey[Deaths].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPet}" Value="True">
                    <Setter TargetName="BarHost" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="330" MinWidth="240" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- The gap doubles as a drag handle: the tree column is resizable
             (transparent splitter, cursor changes on hover). -->
        <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ShowsPreview="False" DragCompleted="TreeSplitter_DragCompleted" />

        <!-- Zone / fight tree -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- WrapPanel, not StackPanel: at higher text scaling the row can
                 outgrow the tree column — wrapping beats clipping. -->
            <WrapPanel Margin="2,0,0,4">
                <ToggleButton Content="{loc:Tr Main_BossesOnly}" Style="{StaticResource PillToggle}" Margin="0,0,6,4"
                              IsChecked="{Binding BossesOnly, Mode=TwoWay}" />
                <Button Content="{loc:Tr Main_Archive}" Style="{StaticResource GoldButton}" Margin="0,0,6,4" Padding="10,3"
                        ToolTip="{loc:Tr Main_TooltipArchive}"
                        Click="Archive_Click" />
                <Button Content="{loc:Tr Main_Curation}" Style="{StaticResource GoldButton}" Margin="0,0,0,4" Padding="10,3"
                        ToolTip="{loc:Tr Main_TooltipCuration}"
                        Click="Curation_Click" />
            </WrapPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <!-- Extended = Explorer-style Ctrl/Shift multi-select; selection
                 is pushed to the VM from FightList_SelectionChanged. -->
            <ListBox x:Name="FightList" ItemsSource="{Binding TreeNodes}" SelectionMode="Extended"
                     SelectionChanged="FightList_SelectionChanged"
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ContextMenuOpening="Tree_ContextMenuOpening"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,1" />
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <!-- Quick picker: children (current settings + saved
                                         presets) are rebuilt by Tree_ContextMenuOpening —
                                         wired on the ListBox, NOT here: an event handler on
                                         an element inside a Style Setter corrupts the XAML
                                         connector ids (InvalidCastException at startup). -->
                                    <MenuItem Tag="discord-picker" Header="{loc:Tr Main_CopyForDiscord}">
                                        <MenuItem Header="{loc:Tr Export_CurrentSettings}" />
                                    </MenuItem>
                                    <MenuItem Tag="compare-picker" Header="{loc:Tr Main_CompareWith}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsFight, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                                        <MenuItem Header="{loc:Tr Main_CompareNone}" />
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr Main_CustomExport}"
                                              Command="{Binding PlacementTarget.Tag.OpenExportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Main_CopySummaryLine}"
                                              Command="{Binding PlacementTarget.Tag.CopyNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Main_ViewLog}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsFight, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                              Command="{Binding PlacementTarget.Tag.ViewFightLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Main_DeathReport}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsFight, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                              Command="{Binding PlacementTarget.Tag.DeathReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Main_AvoidanceReport}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsFight, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                              Command="{Binding PlacementTarget.Tag.AvoidanceReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Main_SpecialAttacksReport}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsFight, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                              Command="{Binding PlacementTarget.Tag.SpecialReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Main_SourcesReport}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsFight, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                              Command="{Binding PlacementTarget.Tag.SourcesReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Main_UploadToEQ2Lexicon}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsFight, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                              Command="{Binding PlacementTarget.Tag.UploadNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Main_Delete}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsDeletable, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                              Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#1AC8A96E" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#33C8A96E" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Collapse lives on the arrow alone; the header
                                 body selects the zone's encounter summary. -->
                            <Button Content="{Binding Arrow}" Style="{StaticResource HeaderButton}"
                                    FontSize="12" Width="18" Margin="0,4,0,0" VerticalAlignment="Top"
                                    HorizontalContentAlignment="Left"
                                    Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ToggleZoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding TitleBrush}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="12,0,0,0" />
                                        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="Margin" Value="0,5,0,0" />
                                                <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Border>
        </Grid>

        <!-- Combatant grid -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Breadcrumb + column picker -->
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,120,0">
                    <TextBlock Text="{Binding Breadcrumb}" Foreground="{StaticResource GoldBrightBrush}"
                               FontFamily="{StaticResource HeadingFont}" FontSize="15"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="99"
                            Background="#334ADE80" Padding="8,2"
                            Visibility="{Binding InCombat, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Tr Main_Live}" FontSize="10" Foreground="{StaticResource SuccessBrush}"
                                   FontFamily="{StaticResource BodySemiBoldFont}" />
                    </Border>
                    <!-- Which log's view of the fight — only when there is
                         more than one (multi-log boxing / merged fights). -->
                    <ComboBox ItemsSource="{Binding Perspectives}" SelectedItem="{Binding SelectedPerspective}"
                              DisplayMemberPath="Label" MinWidth="130" Margin="12,0,0,0" FontSize="12"
                              VerticalAlignment="Center"
                              Visibility="{Binding PerspectiveVisible, Converter={StaticResource BoolToVis}}"
                              ToolTip="{loc:Tr Main_TooltipPerspective}" />
                </StackPanel>
                <ToggleButton x:Name="ColumnsToggle"
                              Content="{loc:Tr Main_Columns}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              PreviewMouseLeftButtonDown="ColumnsToggle_PreviewMouseLeftButtonDown">
                    <ToggleButton.Style>
                        <!-- Configures the combatant grid — hidden while the
                             drill overlay (which has its own picker) or the
                             zone summary covers that grid, so only one
                             COLUMNS button ever shows. -->
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DetailOpen}" Value="False" />
                                        <Condition Binding="{Binding ZoneSummaryOpen}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Popup x:Name="ColumnsPopup" PlacementTarget="{Binding ElementName=ColumnsToggle}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       HorizontalOffset="-160" VerticalOffset="6"
                       IsOpen="{Binding IsChecked, ElementName=ColumnsToggle, Mode=TwoWay}">
                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Main_EncounterColumns}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Columns.Toggles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Visible}"
                                                  Margin="0,3,16,3" Foreground="{StaticResource TextBrush}"
                                                  FontFamily="{StaticResource BodyFont}" FontSize="12.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{loc:Tr Main_ResetToDefault}" Style="{StaticResource GoldButton}"
                                    Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Command="{Binding Columns.ResetCommand}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Encounter-summary bars + average line (follows the sorted
                 column). Pinned ABOVE the column headers so the headers sit
                 directly on top of the rows they label — headers separated
                 from their rows by a 260px chart read as the chart's axis. -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,18,10" Height="260"
                    Visibility="{Binding ChartVisible, Converter={StaticResource BoolToVis}}">
                <lvc:CartesianChart Series="{Binding ChartSeries}"
                                    XAxes="{Binding ChartXAxes}"
                                    YAxes="{Binding ChartYAxes}"
                                    LegendPosition="Hidden"
                                    TooltipPosition="Top"
                                    AnimationsSpeed="0:0:0.35" />
            </Border>

            <!-- Column headers -->
            <Grid Grid.Row="2" Margin="8,0,26,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Class].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=118}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Time].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=56}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Damage].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=82}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Percent].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=44}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Dps].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=82}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Hps].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=82}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Heals].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=82}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[CritHeals].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=76}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Cures].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=56}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[PowerDrain].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=78}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[PowerRep].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=70}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Swings].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=62}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Hits].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=52}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Crits].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=54}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Misses].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=50}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Avoids].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=56}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[ToHit].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=60}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[CritPct].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=56}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Taken].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=82}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[HealsTaken].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=80}" />
                    <ColumnDefinition Width="{Binding Data.ByKey[Deaths].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=50}" />
                </Grid.ColumnDefinitions>
                <Button Content="{loc:Tr Main_ColNAME}" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Name" />
                <Button Grid.Column="1" Content="{loc:Tr Main_ColCLASS}" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Class"
                        Visibility="{Binding Data.ByKey[Class].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="2" Content="{loc:Tr Main_ColTIME}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Duration"
                        Visibility="{Binding Data.ByKey[Time].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="3" Content="{loc:Tr Main_ColDAMAGE}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Damage"
                        Visibility="{Binding Data.ByKey[Damage].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="4" Content="%" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Damage"
                        Visibility="{Binding Data.ByKey[Percent].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="5" Content="{loc:Tr Main_ColENCDPS}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Dps"
                        Visibility="{Binding Data.ByKey[Dps].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="6" Content="{loc:Tr Main_ColENCHPS}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Hps"
                        Visibility="{Binding Data.ByKey[Hps].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="7" Content="{loc:Tr Main_ColHEALS}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Heals"
                        Visibility="{Binding Data.ByKey[Heals].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="8" Content="{loc:Tr Main_ColCRITHEAL}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="CritHeals"
                        Visibility="{Binding Data.ByKey[CritHeals].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="9" Content="{loc:Tr Main_ColCURES}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Cures"
                        Visibility="{Binding Data.ByKey[Cures].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="10" Content="{loc:Tr Main_ColPWRDRN}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="PowerDrain"
                        Visibility="{Binding Data.ByKey[PowerDrain].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="11" Content="{loc:Tr Main_ColPWRREP}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="PowerRep"
                        Visibility="{Binding Data.ByKey[PowerRep].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="12" Content="{loc:Tr Main_ColSWINGS}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Swings"
                        Visibility="{Binding Data.ByKey[Swings].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="13" Content="{loc:Tr Main_ColHITS}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Hits"
                        Visibility="{Binding Data.ByKey[Hits].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="14" Content="{loc:Tr Main_ColCRITS}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Crits"
                        Visibility="{Binding Data.ByKey[Crits].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="15" Content="{loc:Tr Main_ColMISS}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Misses"
                        Visibility="{Binding Data.ByKey[Misses].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="16" Content="{loc:Tr Main_ColAVOID}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Avoids"
                        Visibility="{Binding Data.ByKey[Avoids].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="17" Content="{loc:Tr Main_ColTOHITPCT}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="ToHit"
                        Visibility="{Binding Data.ByKey[ToHit].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="18" Content="{loc:Tr Main_ColCRITPCT}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="CritPct"
                        Visibility="{Binding Data.ByKey[CritPct].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="19" Content="{loc:Tr Main_ColTAKEN}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Taken"
                        Visibility="{Binding Data.ByKey[Taken].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="20" Content="{loc:Tr Main_ColHTAKEN}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="HealsTaken"
                        Visibility="{Binding Data.ByKey[HealsTaken].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="21" Content="{loc:Tr Main_ColDEATHS}" Style="{StaticResource HeaderButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Deaths"
                        Visibility="{Binding Data.ByKey[Deaths].Visible, Source={StaticResource ColsProxy}, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Allies, then pets/enemies flowing directly beneath the last
                 ally row (one shared scroll — nothing pinned to the bottom). -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="6">
                        <ItemsControl ItemsSource="{Binding AllyRows}" ItemTemplate="{StaticResource GridRowTemplate}" />
                    </Border>

                    <Expander Margin="0,10,0,0" IsExpanded="False"
                              Foreground="{StaticResource GoldBrush}">
                        <Expander.Header>
                            <TextBlock Text="{Binding PetHeader}" Style="{StaticResource SectionLabel}" Margin="0" />
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Padding="6" Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding PetRows}" ItemTemplate="{StaticResource GridRowTemplate}" />
                        </Border>
                    </Expander>

                    <Expander Margin="0,6,0,0" IsExpanded="True"
                              Foreground="{StaticResource GoldBrush}">
                        <Expander.Header>
                            <TextBlock Text="{Binding EnemyHeader}" Style="{StaticResource SectionLabel}" Margin="0" />
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Padding="6" Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding EnemyRows}" ItemTemplate="{StaticResource GridRowTemplate}" />
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Zone summary: one row per encounter (zone header selected).
                 Covers the combatant headers + tables; click a row to open
                 that fight. -->
            <Grid Grid.Row="1" Grid.RowSpan="3" Background="{StaticResource BgBrush}"
                  Visibility="{Binding ZoneSummaryOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="8,0,26,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Tr Main_ColENCOUNTER}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="11" Padding="2,4" />
                    <TextBlock Grid.Column="1" Text="{loc:Tr Main_ColSTART}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="11" TextAlignment="Right" Padding="2,4" />
                    <TextBlock Grid.Column="2" Text="{loc:Tr Main_ColTIME}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="11" TextAlignment="Right" Padding="2,4" />
                    <TextBlock Grid.Column="3" Text="{loc:Tr Main_ColDAMAGE}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="11" TextAlignment="Right" Padding="2,4" />
                    <TextBlock Grid.Column="4" Text="{loc:Tr Main_ColENCDPS}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="11" TextAlignment="Right" Padding="2,4" />
                    <TextBlock Grid.Column="5" Text="{loc:Tr Main_ColKILLS}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="11" TextAlignment="Right" Padding="2,4" />
                    <TextBlock Grid.Column="6" Text="{loc:Tr Main_ColDEATHS}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="11" TextAlignment="Right" Padding="2,4" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Padding="6">
                        <ItemsControl ItemsSource="{Binding ZoneSummaryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1" Cursor="Hand" Background="Transparent">
                                        <Grid.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenZoneFightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Grid.InputBindings>
                                        <Border x:Name="SummaryBarHost" CornerRadius="3" Background="#0D1C1F2E" MinHeight="24">
                                            <Border HorizontalAlignment="Left" CornerRadius="3"
                                                    Background="{StaticResource MeterBarBrush}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource BarWidth}">
                                                        <Binding Path="BarFraction" />
                                                        <Binding ElementName="SummaryBarHost" Path="ActualWidth" />
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Border>
                                        <Grid Margin="8,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}"
                                                       FontFamily="{StaticResource BodySemiBoldFont}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Start}" Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Damage}" Foreground="{StaticResource TextBrush}"
                                                       FontFamily="{StaticResource BodyFont}" FontSize="12.5" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding Dps}" Foreground="{StaticResource GoldBrightBrush}"
                                                       FontFamily="{StaticResource BodySemiBoldFont}" FontSize="13" TextAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding Kills}" Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="{StaticResource BodyFont}" FontSize="12.5" TextAlignment="Right" />
                                            <TextBlock Grid.Column="6" Text="{Binding Deaths}" Foreground="{StaticResource DangerBrush}"
                                                       FontFamily="{StaticResource BodyFont}" FontSize="12.5" TextAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Drill-down overlay (covers everything below the breadcrumb) -->
            <Grid Grid.Row="1" Grid.RowSpan="3" Background="{StaticResource BgBrush}"
                  Visibility="{Binding DetailOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,120,0">
                        <Button Content="{loc:Tr Main_Back}" Style="{StaticResource GoldButton}" Command="{Binding CloseDetailCommand}" />
                        <TextBlock Text="{Binding DetailTitle}" Foreground="{StaticResource GoldBrightBrush}"
                                   FontFamily="{StaticResource HeadingFont}" FontSize="16"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                        <Button Content="{loc:Tr Main_CopyReport}" Style="{StaticResource GoldButton}" Margin="16,0,0,0"
                                Command="{Binding CopyReportCommand}"
                                Visibility="{Binding ReportLevel, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ToggleButton x:Name="DrillColumnsToggle" Style="{StaticResource PillToggle}"
                                  Content="{loc:Tr Main_Columns}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Visibility="{Binding DrillTableVisible, Converter={StaticResource BoolToVis}}"
                                  PreviewMouseLeftButtonDown="DrillColumnsToggle_PreviewMouseLeftButtonDown" />
                    <ToggleButton x:Name="SwingColumnsToggle" Style="{StaticResource PillToggle}"
                                  Content="{loc:Tr Main_Columns}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Visibility="{Binding SwingTableVisible, Converter={StaticResource BoolToVis}}"
                                  PreviewMouseLeftButtonDown="SwingColumnsToggle_PreviewMouseLeftButtonDown" />
                    <Popup x:Name="SwingColumnsPopup" PlacementTarget="{Binding ElementName=SwingColumnsToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           HorizontalOffset="-100" VerticalOffset="6"
                           IsOpen="{Binding IsChecked, ElementName=SwingColumnsToggle, Mode=TwoWay}">
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Main_SwingLogColumns}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding SwingColumns.Toggles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding Visible}"
                                                      Margin="0,3,16,3" Foreground="{StaticResource TextBrush}"
                                                      FontFamily="{StaticResource BodyFont}" FontSize="12.5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{loc:Tr Main_ResetToDefault}" Style="{StaticResource GoldButton}"
                                        Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Command="{Binding SwingColumns.ResetCommand}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="DrillColumnsPopup" PlacementTarget="{Binding ElementName=DrillColumnsToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           HorizontalOffset="-100" VerticalOffset="6"
                           IsOpen="{Binding IsChecked, ElementName=DrillColumnsToggle, Mode=TwoWay}">
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Main_CombatantColumns}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding DrillColumns.Toggles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding Visible}"
                                                      Margin="0,3,16,3" Foreground="{StaticResource TextBrush}"
                                                      FontFamily="{StaticResource BodyFont}" FontSize="12.5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{loc:Tr Main_ResetToDefault}" Style="{StaticResource GoldButton}"
                                        Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Command="{Binding DrillColumns.ResetCommand}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Depth-aware drill chart: bucket activity lines, ability
                     doughnut, or per-skill heat strip. -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,10" Height="230"
                        Visibility="{Binding DrillChartVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <lvc:CartesianChart Series="{Binding DrillCartesianSeries}"
                                            XAxes="{Binding DrillXAxes}"
                                            YAxes="{Binding DrillYAxes}"
                                            LegendPosition="Bottom"
                                            LegendTextPaint="{Binding DrillLegendPaint}"
                                            TooltipPosition="Top"
                                            AnimationsSpeed="0:0:0.3"
                                            Visibility="{Binding DrillCartesianVisible, Converter={StaticResource BoolToVis}}" />
                        <lvc:PieChart Series="{Binding DrillDonutSeries}"
                                      InitialRotation="-90"
                                      LegendPosition="Right"
                                      LegendTextPaint="{Binding DonutLegendPaint}"
                                      TooltipPosition="Top"
                                      AnimationsSpeed="0:0:0.3"
                                      Visibility="{Binding DrillDonutVisible, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
                <!-- Bucket / ability table (depths 1-2) -->
                <Grid Grid.Row="2" Visibility="{Binding SwingLevel, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Damage].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=80}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Dps].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=78}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Types].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=110}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Source].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=52}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Swings].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=56}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Freq].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=54}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Hits].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=50}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[CritPct].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=50}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Avg].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=66}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Max].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=72}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Percent].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=40}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DrillNameHeader}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" />
                        <TextBlock Grid.Column="1" Text="{loc:Tr Main_ColDAMAGE}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" TextAlignment="Right"
                                   Visibility="{Binding Data.ByKey[Damage].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="2" Text="{loc:Tr Main_ColENCDPS}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" TextAlignment="Right"
                                   Visibility="{Binding Data.ByKey[Dps].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="3" Text="{loc:Tr Main_ColTYPE}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" Margin="12,0,0,0"
                                   Visibility="{Binding Data.ByKey[Types].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="4" Text="{loc:Tr Main_ColSOURCE}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5"
                                   Visibility="{Binding Data.ByKey[Source].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="5" Text="{loc:Tr Main_ColSWINGS}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" TextAlignment="Right"
                                   Visibility="{Binding Data.ByKey[Swings].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="6" Text="{loc:Tr Main_ColFREQ}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" TextAlignment="Right"
                                   ToolTip="{loc:Tr Main_TooltipFreq}"
                                   Visibility="{Binding Data.ByKey[Freq].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="7" Text="{loc:Tr Main_ColHITS}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" TextAlignment="Right"
                                   Visibility="{Binding Data.ByKey[Hits].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="8" Text="{loc:Tr Main_ColCRITPCT}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" TextAlignment="Right"
                                   Visibility="{Binding Data.ByKey[CritPct].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="9" Text="{loc:Tr Main_ColAVG}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" TextAlignment="Right"
                                   Visibility="{Binding Data.ByKey[Avg].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="10" Text="{loc:Tr Main_ColMAX}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" TextAlignment="Right"
                                   Visibility="{Binding Data.ByKey[Max].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="11" Text="%" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" TextAlignment="Right"
                                   Visibility="{Binding Data.ByKey[Percent].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DrillRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AbilityRow}">
                                        <Grid x:Name="RowRoot" Margin="0,1" Cursor="Hand" Background="Transparent"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                <MenuItem Header="{loc:Tr Main_LookupByCombatant}"
                                                          Command="{Binding PlacementTarget.Tag.LookupBucketByCombatantCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="{loc:Tr Main_CopyRow}"
                                                          Command="{Binding PlacementTarget.Tag.CopyAbilityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.DrillIntoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Grid.InputBindings>
                                            <Border x:Name="AbilityBarHost" CornerRadius="3" Background="#0D1C1F2E" MinHeight="22">
                                                <Border HorizontalAlignment="Left" CornerRadius="3"
                                                        Background="{StaticResource MeterBarBrush}">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource BarWidth}">
                                                            <Binding Path="BarFraction" />
                                                            <Binding ElementName="AbilityBarHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Border>
                                            <Grid Margin="8,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[Damage].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=80}" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[Dps].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=78}" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[Types].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=110}" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[Source].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=52}" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[Swings].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=56}" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[Freq].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=54}" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[Hits].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=50}" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[CritPct].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=50}" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[Avg].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=66}" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[Max].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=72}" />
                                                    <ColumnDefinition Width="{Binding Data.ByKey[Percent].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=40}" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="RowName" Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                                           FontFamily="{StaticResource BodyFont}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Total}" Foreground="{StaticResource GoldBrightBrush}"
                                                           FontFamily="{StaticResource BodySemiBoldFont}" FontSize="13" TextAlignment="Right"
                                                           Visibility="{Binding Data.ByKey[Damage].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Dps}" Foreground="{StaticResource GoldBrightBrush}"
                                                           FontFamily="{StaticResource BodySemiBoldFont}" FontSize="13" TextAlignment="Right"
                                                           Visibility="{Binding Data.ByKey[Dps].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Types}" Foreground="{StaticResource TextMutedBrush}"
                                                           FontFamily="{StaticResource BodyFont}" FontSize="11.5" Margin="12,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Data.ByKey[Types].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Source}" Foreground="{Binding SourceBrush}"
                                                           FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                                                           Visibility="{Binding Data.ByKey[Source].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="5" Text="{Binding Casts}" Foreground="{StaticResource TextMutedBrush}"
                                                           FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                                                           Visibility="{Binding Data.ByKey[Swings].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="6" Text="{Binding Freq}" Foreground="{StaticResource TextMutedBrush}"
                                                           FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                                                           Visibility="{Binding Data.ByKey[Freq].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="7" Text="{Binding Hits}" Foreground="{StaticResource TextMutedBrush}"
                                                           FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                                                           Visibility="{Binding Data.ByKey[Hits].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="8" Text="{Binding CritPct}" Foreground="{StaticResource TextMutedBrush}"
                                                           FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                                                           Visibility="{Binding Data.ByKey[CritPct].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="9" Text="{Binding Avg}" Foreground="{StaticResource TextBrush}"
                                                           FontFamily="{StaticResource BodyFont}" FontSize="12.5" TextAlignment="Right"
                                                           Visibility="{Binding Data.ByKey[Avg].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="10" Text="{Binding Max}" Foreground="{StaticResource TextBrush}"
                                                           FontFamily="{StaticResource BodyFont}" FontSize="12.5" TextAlignment="Right"
                                                           Visibility="{Binding Data.ByKey[Max].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="11" Text="{Binding Percent}" Foreground="{StaticResource TextMutedBrush}"
                                                           FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right"
                                                           Visibility="{Binding Data.ByKey[Percent].Visible, Source={StaticResource DrillColsProxy}, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsGroupLabel}" Value="True">
                                                <Setter TargetName="RowRoot" Property="Cursor" Value="Arrow" />
                                                <Setter TargetName="RowRoot" Property="Margin" Value="0,8,0,1" />
                                                <Setter TargetName="AbilityBarHost" Property="Background" Value="Transparent" />
                                                <Setter TargetName="AbilityBarHost" Property="MinHeight" Value="18" />
                                                <Setter TargetName="RowName" Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                <Setter TargetName="RowName" Property="FontFamily" Value="{StaticResource HeadingFont}" />
                                                <Setter TargetName="RowName" Property="FontSize" Value="11" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Swing list (depth 3) -->
                <Grid Grid.Row="2" Visibility="{Binding SwingTableVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Data.ByKey[Time].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=80}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Result].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=100}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Crit].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=48}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Special].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=110}" />
                            <ColumnDefinition Width="{Binding Data.ByKey[Type].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=100}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr Main_ColTIME}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5"
                                   Visibility="{Binding Data.ByKey[Time].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="1" Text="{loc:Tr Main_ColRESULT}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" TextAlignment="Right"
                                   Visibility="{Binding Data.ByKey[Result].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="2" Text="{loc:Tr Main_ColCRIT}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" Margin="12,0,0,0"
                                   Visibility="{Binding Data.ByKey[Crit].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="3" Text="{loc:Tr Main_ColSPECIAL}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5"
                                   Visibility="{Binding Data.ByKey[Special].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="4" Text="{loc:Tr Main_ColTYPE}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5"
                                   Visibility="{Binding Data.ByKey[Type].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="5" Text="{loc:Tr Main_ColTARGET}" Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                        <ListBox ItemsSource="{Binding SwingRows}" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SwingRow}">
                                    <Grid Cursor="Hand" Background="Transparent"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                            <MenuItem Header="{loc:Tr Main_ViewLog}"
                                                      Command="{Binding PlacementTarget.Tag.OpenSwingLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{loc:Tr Main_CopyLine}"
                                                      Command="{Binding PlacementTarget.Tag.CopySwingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenSwingLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Data.ByKey[Time].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=80}" />
                                            <ColumnDefinition Width="{Binding Data.ByKey[Result].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=100}" />
                                            <ColumnDefinition Width="{Binding Data.ByKey[Crit].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=48}" />
                                            <ColumnDefinition Width="{Binding Data.ByKey[Special].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=110}" />
                                            <ColumnDefinition Width="{Binding Data.ByKey[Type].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource ColWidth}, ConverterParameter=100}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="{StaticResource BodyFont}" FontSize="12"
                                                   Visibility="{Binding Data.ByKey[Time].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Result}" Foreground="{StaticResource GoldBrightBrush}"
                                                   FontFamily="{StaticResource BodySemiBoldFont}" FontSize="12.5" TextAlignment="Right"
                                                   Visibility="{Binding Data.ByKey[Result].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Crit}" Foreground="{StaticResource WarningBrush}"
                                                   FontFamily="{StaticResource BodyFont}" FontSize="11.5" Margin="12,0,0,0"
                                                   Visibility="{Binding Data.ByKey[Crit].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Special}" Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                                                   Visibility="{Binding Data.ByKey[Special].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Type}" Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                                                   Visibility="{Binding Data.ByKey[Type].Visible, Source={StaticResource SwingColsProxy}, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Other}" Foreground="{StaticResource TextBrush}"
                                                   FontFamily="{StaticResource BodyFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <!-- Side-by-side avoidance doughnuts (report chart) -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,10" Height="250"
                        Visibility="{Binding ReportChartVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <lvc:CartesianChart Series="{Binding ReportCartesianSeries}"
                                            XAxes="{Binding ReportCartesianXAxes}"
                                            YAxes="{Binding ReportCartesianYAxes}"
                                            LegendPosition="Hidden"
                                            TooltipPosition="Top"
                                            AnimationsSpeed="0:0:0.3"
                                            Visibility="{Binding ReportCartesianVisible, Converter={StaticResource BoolToVis}}" />
                        <Grid Visibility="{Binding ReportDonutsVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding ReportChartTitle1}" Style="{StaticResource SectionLabel}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <lvc:PieChart Grid.Row="1" Series="{Binding ReportDonutInner}"
                                          InitialRotation="-90"
                                          LegendPosition="Right"
                                          LegendTextPaint="{Binding ReportLegendPaint}"
                                          TooltipPosition="Top"
                                          AnimationsSpeed="0:0:0.3" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding ReportChartTitle2}" Style="{StaticResource SectionLabel}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <lvc:PieChart Grid.Row="1" Series="{Binding ReportDonutOuter}"
                                          InitialRotation="-90"
                                          LegendPosition="Right"
                                          LegendTextPaint="{Binding BreakdownLegendPaint}"
                                          TooltipPosition="Top"
                                          AnimationsSpeed="0:0:0.3" />
                        </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Report view (death / avoidance / specials / lookup) -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10"
                        Visibility="{Binding ReportLevel, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding ReportRows}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LogRow}">
                                <TextBlock views:SegmentedText.Segments="{Binding Segments}"
                                           FontFamily="Consolas" FontSize="13" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Raw log view (deepest drill: one swing in context) -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"
                        Visibility="{Binding LogLevel, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding LogRows}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFocus}" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#26C8A96E" />
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GoldDimBrush}" />
                                                    <Setter TargetName="Row" Property="BorderThickness" Value="2,0,0,0" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LogRow}">
                                <TextBlock views:SegmentedText.Segments="{Binding Segments}"
                                           FontFamily="Consolas" FontSize="12.5"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
