<Window x:Class="EQ2Parser.App.Views.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EQ2Parser.App.Localization"
        Title="{loc:Tr Archive_WindowTitle}" Width="720" Height="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="8,5" FontSize="13">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ComboBox Grid.Column="1" ItemsSource="{Binding RangeChoices}" SelectedIndex="{Binding RangeIndex}"
                      Margin="8,0,0,0" MinWidth="120" FontSize="13" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="{loc:Tr Archive_Search}" Style="{StaticResource GoldButton}" Margin="8,0,0,0"
                    Command="{Binding SearchCommand}" />
            <Button Grid.Column="3" Content="{loc:Tr Archive_LoadAll}" Style="{StaticResource GoldButton}" Margin="8,0,0,0"
                    ToolTip="{loc:Tr Archive_LoadAllTooltip}"
                    Command="{Binding LoadAllCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <ListBox ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="{Binding OutcomeBrush}"
                                         VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="14"
                                                   FontFamily="{StaticResource BodySemiBoldFont}"
                                                   Foreground="{StaticResource GoldBrightBrush}" />
                                        <Border Background="#26C8A96E" CornerRadius="99" Padding="8,1" Margin="10,2,0,0">
                                            <TextBlock Text="{Binding Zone}" FontSize="10" Foreground="{StaticResource GoldBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding WhenLabel}" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBlock Text="{Binding DetailLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="12,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr Archive_InParser}" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="{loc:Tr Archive_Load}" Style="{StaticResource GoldButton}" Padding="12,3"
                                            ToolTip="{loc:Tr Archive_LoadTooltip}"
                                            Visibility="{Binding IsLoaded, Converter={StaticResource InverseBoolToVis}}"
                                            Command="{Binding DataContext.LoadRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="✕" Style="{StaticResource GoldButton}" Padding="8,3" Margin="6,0,0,0"
                                            ToolTip="{loc:Tr Archive_PurgeTooltip}"
                                            Command="{Binding DataContext.PurgeRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Why there is no archive this session, or the operation that just
             failed. Its own row so a long sentence can wrap; collapsed
             when there is nothing to say. -->
        <TextBlock Grid.Row="2" AutomationProperties.AutomationId="ArchiveNotice"
                   Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{StaticResource WarningBrush}" FontSize="12"
                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ResultLabel}" Foreground="{StaticResource GoldBrush}" FontSize="12" />
            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Right"
                       Text="{loc:Tr Archive_FooterHint}" />
        </Grid>
    </Grid>
</Window>
