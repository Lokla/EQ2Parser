<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless harness for the macOS port: tails a log through the same
       SourceManager the app uses and prints fights as they happen. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>eq2parser-cli</AssemblyName>
    <RootNamespace>EQ2Parser.Mac.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQ2Parser.Shell\EQ2Parser.Shell.csproj" />
  </ItemGroup>

</Project>
