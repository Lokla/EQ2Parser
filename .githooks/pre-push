#!/bin/sh
# Pre-push checks — runs automatically before every `git push`.
# Activate once with:  git config core.hooksPath .githooks
# Mirrors CI (.github/workflows/ci.yml): build, format, test — via
# scripts/tools/verify.ps1, which prints failures only and builds under
# artifacts/ when a running copy of the app holds bin/ open (a plain
# `dotnet build` here would fail on the locked DLLs and block the push).
set -e

root=$(git rev-parse --show-toplevel)
if command -v pwsh >/dev/null 2>&1; then
  shell=pwsh
else
  shell=powershell.exe
fi

echo ""
echo "Running pre-push checks (scripts/tools/verify.ps1)…"
echo ""
exec "$shell" -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/tools/verify.ps1"
